# 로컬 에뮬레이터로 바로 실행할 때 쓰는 값입니다.
# 프로덕션에서는 Firebase 콘솔의 웹 앱 설정으로 바꾸고 USE_FIREBASE_EMULATOR를 false로 둡니다.

NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-salesmap.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-salesmap
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-salesmap.appspot.com

# Kakao Developers에서 발급한 JavaScript 키. 비어 있으면 지도 없이 목록으로 동작합니다.
NEXT_PUBLIC_KAKAO_MAP_KEY=
