{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "../shared/src"],
  "exclude": ["../shared/src/**/*.test.ts", "src/**/*.test.ts"]
}
